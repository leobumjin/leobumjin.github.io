---
layout: none
---
[
{% for post in site.posts %}
  {
    "path": {{ post.path | remove_first: '_posts/' | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "text": {{ post.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
